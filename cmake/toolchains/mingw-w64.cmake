# Cross-compile on a POSIX host using an x86-64 MinGW-w64 compiler and Windows Qt.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)

set(COMMLINK_MINGW_ROOT "$ENV{COMMLINK_MINGW_ROOT}" CACHE PATH "MinGW installation prefix (optional when on PATH)")
set(COMMLINK_WINDOWS_QT_ROOT "$ENV{COMMLINK_WINDOWS_QT_ROOT}" CACHE PATH "Windows Qt installation prefix")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES
    COMMLINK_MINGW_ROOT COMMLINK_WINDOWS_QT_ROOT)

find_program(CMAKE_C_COMPILER
    NAMES x86_64-w64-mingw32-gcc-posix x86_64-w64-mingw32-gcc
    HINTS "${COMMLINK_MINGW_ROOT}/bin" NO_CMAKE_FIND_ROOT_PATH)
find_program(CMAKE_CXX_COMPILER
    NAMES x86_64-w64-mingw32-g++-posix x86_64-w64-mingw32-g++
    HINTS "${COMMLINK_MINGW_ROOT}/bin" NO_CMAKE_FIND_ROOT_PATH)
find_program(CMAKE_RC_COMPILER
    NAMES x86_64-w64-mingw32-windres
    HINTS "${COMMLINK_MINGW_ROOT}/bin" NO_CMAKE_FIND_ROOT_PATH)
if(NOT CMAKE_C_COMPILER OR NOT CMAKE_CXX_COMPILER OR NOT CMAKE_RC_COMPILER)
    message(FATAL_ERROR "MinGW-w64 compilers not found; set COMMLINK_MINGW_ROOT or add them to PATH")
endif()

if(COMMLINK_MINGW_ROOT)
    list(APPEND CMAKE_FIND_ROOT_PATH "${COMMLINK_MINGW_ROOT}/x86_64-w64-mingw32")
endif()
if(COMMLINK_WINDOWS_QT_ROOT)
    list(APPEND CMAKE_FIND_ROOT_PATH "${COMMLINK_WINDOWS_QT_ROOT}")
    list(PREPEND CMAKE_PREFIX_PATH "${COMMLINK_WINDOWS_QT_ROOT}")
endif()
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
